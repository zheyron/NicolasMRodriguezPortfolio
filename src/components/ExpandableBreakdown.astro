---
interface Props {title:string;details:string;evidenceIds:string[];}
const {title,details,evidenceIds}=Astro.props;
---
<details class="expandable-breakdown"><summary>{title}<span aria-hidden="true">+</span></summary><div><p>{details}</p>{evidenceIds.map(id=><a class="text-link" href={'#evidence-'+id}>View supporting evidence ↗</a>)}</div></details>
