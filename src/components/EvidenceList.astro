---
import {withBase} from '../lib/paths';
interface Props {items:Array<{id:string;title:string;description:string;publicUrl?:string;lastVerifiedAt:string;image?:{src:string;alt:string;width:number;height:number;caption:string;credit:string}}>}
const {items}=Astro.props;
---
{items.length>0&&<section class="article-section"><h2>Evidence & references</h2><div class="evidence-list">{items.map(e=><article id={`evidence-${e.id}`} class="evidence-item"><h3>{e.publicUrl?<a href={e.publicUrl}>{e.title} ↗</a>:e.title}</h3><p>{e.description}</p>{e.image&&<figure><img src={withBase(e.image.src,import.meta.env.BASE_URL)} alt={e.image.alt} width={e.image.width} height={e.image.height} loading="lazy"/><figcaption>{e.image.caption} · {e.image.credit}</figcaption></figure>}<small>Source reviewed {e.lastVerifiedAt}</small></article>)}</div></section>}
