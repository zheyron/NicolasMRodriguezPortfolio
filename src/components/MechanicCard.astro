---
import type {CollectionEntry} from 'astro:content';import {withBase} from '../lib/paths';import Cover from './Cover.astro';
interface Props {item:CollectionEntry<'mechanics'>;parentTitle?:string}
const {item,parentTitle}=Astro.props;const d=item.data;
---
<article class:list={['mechanic-card',{'with-media':!!d.cover}]}><a href={withBase(`/mechanics/${item.id}/`,import.meta.env.BASE_URL)}>{d.cover&&<Cover title={d.title!} cover={d.cover}/>}<div class="mechanic-copy"><div class="eyebrow">{d.discipline} <span> / {d.depth==='case-study'?'Case study':'Overview'}</span></div><h3>{d.title}<span aria-hidden="true">↗</span></h3><p>{d.shortDescription}</p><div class="mechanic-parent">{parentTitle}</div></div></a></article>
