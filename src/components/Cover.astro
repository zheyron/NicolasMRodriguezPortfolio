---
import {withBase} from '../lib/paths';
interface Props { title:string; accent?:string; category?:string; index?:string; cover?:{src:string;alt:string;width:number;height:number;pixelArt?:boolean}; eager?:boolean }
const {title,accent='mint',category='Game project',cover,eager=false}=Astro.props;
---
<div class:list={['cover',`tone-${accent}`,{'has-image':!!cover,'pixel-art':cover?.pixelArt}]}>
{cover?<img src={withBase(cover.src,import.meta.env.BASE_URL)} alt={cover.alt} width={cover.width} height={cover.height} loading={eager?'eager':'lazy'} fetchpriority={eager?'high':undefined} decoding="async"/>:<div class="type-cover" aria-hidden="true"><span class="cover-category">{category}</span><span class="cover-title">{title}</span><span class="cover-bottom">PROJECT NOTES <span>↗</span></span></div>}
</div>
