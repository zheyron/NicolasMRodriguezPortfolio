---
import type {CollectionEntry} from 'astro:content';import {withBase} from '../lib/paths';import MediaLoop from './MediaLoop.astro';import Cover from './Cover.astro';
interface Props {card:CollectionEntry<'projects'>['data']['showcaseCards'][number];projectId:string;}
const {card,projectId}=Astro.props;
const path=card.linkedMechanicId?'/mechanics/'+card.linkedMechanicId+'/':'/work/'+projectId+'/'+(card.detailAnchor?'#'+card.detailAnchor:'');
const labels={gameplay:'Explore the game',design:'Read the design breakdown',production:'See my contribution',mechanic:'View this mechanic'};
---
<article class="showcase-card">{card.loop?<MediaLoop media={card.loop}/>:card.media&&<Cover title={card.title} cover={card.media}/>}<div class="showcase-copy"><p class="eyebrow">{card.kind}</p><h3>{card.title}</h3><p>{card.summary}</p><a class="text-link" href={withBase(path,import.meta.env.BASE_URL)}>{labels[card.kind]} <span aria-hidden="true">↗</span></a></div></article>
