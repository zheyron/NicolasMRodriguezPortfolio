---
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import GameCursor from '../components/GameCursor.astro';
import {site} from '../data/site';
import {withBase} from '../lib/paths';
import '../styles/global.css';
interface Props {title:string;description?:string;noindex?:boolean;socialImage?:{src:string;alt:string;width:number;height:number}}
const url=(p:string)=>withBase(p,import.meta.env.BASE_URL);
---
<!doctype html><html lang="en"><head><SeoHead {...Astro.props}/><GameCursor/></head><body>
<a class="skip-link" href="#main">Skip to content</a><SiteHeader/>
<main id="main" tabindex="-1"><slot/></main>
<footer class="site-footer shell"><div><a class="footer-name" href={url('/')}>{site.name}<span class="accent">.</span></a><p>Games, systems, and the work in between.</p></div><div class="footer-links"><a href={url('/contact/')}>Contact</a><a href={`mailto:${site.email}`}>{site.email}</a><a href={site.linkedin}>LinkedIn ↗</a><a href={site.github}>GitHub ↗</a><a href={site.studio}>Fuenteki ↗</a><span>© {new Date().getUTCFullYear()} Nicolás Rodríguez</span></div></footer>
</body></html>
