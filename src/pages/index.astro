---
import {home} from '../data/home';
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedGameChapter from '../components/FeaturedGameChapter.astro';
import MechanicCard from '../components/MechanicCard.astro';
import CharacterScrollLayers from '../components/CharacterScrollLayers.astro';
import {content} from '../lib/content';
import {withBase} from '../lib/paths';
const {projects,mechanics}=await content();
const selected=projects.filter(p=>p.data.featuredChapter).sort((a,b)=>(a.data.chapterOrder??999)-(b.data.chapterOrder??999)||a.id.localeCompare(b.id)).slice(0,4);
const other=projects.filter(p=>p.data.projectType!=='game');
const snowy=projects.find(p=>p.id===home.characterProjectId);
const url=(p:string)=>withBase(p,import.meta.env.BASE_URL);
---
<BaseLayout title="Home"><div class="shell home-shell">
  <header class="personal-hero">
    <div class="hero-copy"><p class="eyebrow">{home.eyebrow}</p><h1>Nicolás<br/>Rodríguez<span class="accent">.</span></h1><p class="hero-role">{home.role}</p><p class="hero-description">{home.introduction}</p><div class="actions"><a class="button primary" href="#selected-games">View Work <span aria-hidden="true">↓</span></a><a class="button" href={url('/contact/')}>Contact ↗</a></div></div>
    <div class="hero-art"><div class="snowy-orbit"><span class="orbit-label">A little character.<br/>A lot going on underneath.</span>{snowy&&<CharacterScrollLayers layers={snowy.data.characterLayers.map(l=>({...l,axis:'y' as const,start:32,end:-32,anchor:'center' as const,size:160}))}/>}<span class="character-caption">{home.characterLabel}</span></div></div>
  </header>
  <section id="selected-games" class="selected-games" aria-labelledby="selected"><div class="section-heading"><div><p class="eyebrow">01 / Selected games</p><h2 id="selected">Games with a world of their own.</h2></div><a class="text-link" href={url('/work/')}>All projects ↗</a></div>{selected.map((item,index)=><FeaturedGameChapter item={item} index={index}/>)}</section>
  <section class="section home-studies" aria-labelledby="systems"><div class="section-heading"><div><p class="eyebrow">02 / Behind the play</p><h2 id="systems">Mechanics & Systems</h2></div><a class="text-link" href={url('/mechanics/')}>All mechanics ↗</a></div><p class="section-intro">The rules, interfaces, and implementation that connect a game’s ideas to its players.</p><div class="mechanic-grid">{mechanics.filter(m=>m.data.featured).map(item=><MechanicCard item={item} parentTitle={projects.find(p=>p.id===item.data.parentProject)?.data.title}/>)}</div></section>
  <section class="section" aria-labelledby="other"><div class="section-heading"><div><p class="eyebrow">03 / Other projects</p><h2 id="other">Different ways to make a game.</h2></div></div><div class="compact-projects">{other.map(p=><a href={url('/work/'+p.id+'/')}><div><span class="eyebrow">{p.data.projectType}</span><h3>{p.data.title}</h3><p>{p.data.shortDescription}</p></div><span aria-hidden="true">↗</span></a>)}</div></section>
  <section class="section how-i-work" aria-labelledby="approach"><div><p class="eyebrow">04 / How I work</p><h2 id="approach">Direction. <br/>Design. <br/>Getting it built.</h2></div><div><p class="large-copy">My work connects the overall direction of a game with the systems that make it playable.</p><p>Across indie and academic projects, I contribute through production, game design, programming, and VFX. Fuenteki is part of that journey; this portfolio follows my individual work.</p><a class="text-link" href={url('/about/')}>More about me ↗</a></div></section>
  <section class="closing-note"><div><p class="eyebrow">05 / Let’s talk games</p><h2>Have something<br/>in mind?</h2></div><a class="button primary" href={url('/contact/')}>Get in touch ↗</a></section>
</div></BaseLayout>
