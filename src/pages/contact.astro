---
import BaseLayout from '../layouts/BaseLayout.astro';import {site} from '../data/site';
---
<BaseLayout title="Contact" description="Contact Nicolás Rodríguez by email or LinkedIn."><div class="shell"><header class="page-heading"><p class="eyebrow">Contact</p><h1>Let’s talk<br/><span class="hero-secondary">about games.</span></h1><p>For work, game development, or a conversation about a project, get in touch.</p></header><section class="contact-options" aria-label="Public contact channels"><a href={`mailto:${site.email}`}><span class="eyebrow">Get in touch</span><h2>Email ↗</h2><p>{site.email}</p></a><a href={site.linkedin}><span class="eyebrow">Professional profile</span><h2>LinkedIn ↗</h2><p>Nicolás Rodríguez</p></a><a href={site.studio}><span class="eyebrow">Indie games</span><h2>Fuenteki ↗</h2><p>Visit the studio and explore our games.</p></a></section></div></BaseLayout>
