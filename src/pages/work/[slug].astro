---
import {render,type CollectionEntry} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import Cover from '../../components/Cover.astro';import EvidenceList from '../../components/EvidenceList.astro';import VideoPoster from '../../components/VideoPoster.astro';import MechanicCard from '../../components/MechanicCard.astro';import {content} from '../../lib/content';import {statusLabels} from '../../lib/contracts';import {withBase} from '../../lib/paths';
export async function getStaticPaths(){const {projects}=await content();return projects.map(item=>({params:{slug:item.id},props:{item}}));}
interface Props{item:CollectionEntry<'projects'>}const {item}=Astro.props;const d=item.data;const {Content}=await render(item);const {projects,mechanics}=await content();const related=mechanics.filter(m=>m.data.parentProject===item.id);const next=projects[(projects.findIndex(p=>p.id===item.id)+1)%projects.length];const url=(p:string)=>withBase(p,import.meta.env.BASE_URL);
---
<BaseLayout title={d.title!} description={d.shortDescription}><div class="shell detail"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={url('/work/')}>Work</a><span aria-hidden="true">/</span><span>{d.title}</span></nav><header class="detail-heading"><p class="eyebrow">{d.projectType==='collaboration'?'QA collaboration':d.projectType==='modding'?'Modding / Kenshi':'Project overview'}</p><h1>{d.title}</h1><p class="lede">{d.shortDescription}</p><dl class="metadata"><div><dt>My role</dt><dd>{d.roles.join(' · ')}</dd></div>{d.technologies.length>0&&<div><dt>Tools</dt><dd>{d.technologies.join(' · ')}</dd></div>}{d.productStatus&&<div><dt>Status</dt><dd>{statusLabels[d.productStatus]}{d.availability&&` · ${d.availability}`}</dd></div>}{d.context&&<div><dt>Context</dt><dd>{d.context.replaceAll('-',' ')}</dd></div>}</dl><div class="contribution"><span class="eyebrow">My contribution</span><p>{d.attribution}</p></div>{d.links.length>0&&<div class="actions">{d.links.map((l,i)=><a class:list={['button',{'primary':i===0}]} href={l.url}>{l.label} ↗</a>)}</div>}</header><Cover title={d.title!} accent={d.accent} cover={d.cover} category={d.technologies.join(' / ')||d.projectType} eager/>
<div class="reading"><div class="prose"><Content/></div>{d.decisions.length>0&&<section class="article-section"><h2>Key decisions</h2>{d.decisions.map(dec=><article class="decision"><h3>{dec.title}</h3><p>{dec.problem}</p><p>{dec.action}</p>{dec.rationale&&<p>{dec.rationale}</p>}{dec.outcome&&<p>{dec.outcome}</p>}<div>{dec.evidenceIds.map(id=><a class="text-link" href={`#evidence-${id}`}>View evidence →</a>)}</div></article>)}</section>}{d.video&&<VideoPoster video={d.video}/>}<EvidenceList items={d.evidence}/>{d.credits.length>0&&<section class="article-section"><h2>Team & credits</h2><ul class="credits">{d.credits.map(c=><li><strong>{c.name}</strong><span>{c.role}</span></li>)}</ul></section>}</div>
{related.length>0&&<section class="section"><div class="section-heading"><h2>Inside this project</h2></div><div class="mechanic-grid">{related.map(m=><MechanicCard item={m} parentTitle={d.title}/>)}</div></section>}
<nav class="detail-end" aria-label="More work"><a href={url('/work/')}>← All projects</a><a href={url(`/work/${next.id}/`)}>Next: {next.data.title} →</a><a href={url('/contact/')}>Get in touch ↗</a></nav></div></BaseLayout>
