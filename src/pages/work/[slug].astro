---
import {render,type CollectionEntry} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DecisionSummary from '../../components/DecisionSummary.astro';
import MediaLoop from '../../components/MediaLoop.astro';
import StoreCTA from '../../components/StoreCTA.astro';
import SteamPanel from '../../components/SteamPanel.astro';
import Cover from '../../components/Cover.astro';
import EvidenceList from '../../components/EvidenceList.astro';
import VideoPoster from '../../components/VideoPoster.astro';
import MechanicCard from '../../components/MechanicCard.astro';
import MediaGallery from '../../components/MediaGallery.astro';
import {content} from '../../lib/content';
import {statusLabels} from '../../lib/contracts';
import {withBase} from '../../lib/paths';
export async function getStaticPaths(){const {projects}=await content();return projects.map(item=>({params:{slug:item.id},props:{item}}));}
interface Props{item:CollectionEntry<'projects'>}
const {item}=Astro.props, d=item.data;
const {Content}=await render(item);
const {projects,mechanics}=await content();
const related=mechanics.filter(m=>m.data.parentProject===item.id);
const next=projects[(projects.findIndex(p=>p.id===item.id)+1)%projects.length];
const url=(p:string)=>withBase(p,import.meta.env.BASE_URL);
---
<BaseLayout title={d.title!} description={d.shortDescription} socialImage={d.cover}><div class="shell detail project-detail">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={url('/work/')}>Work</a><span aria-hidden="true">/</span><span>{d.title}</span></nav>
  <header class="project-heading">
    <div><p class="eyebrow">{d.projectType==='modding'?'Modding / Kenshi':d.technologies.join(' · ')||'Project'}</p><h1>{d.title}</h1>{d.tagline&&<p class="project-tagline">{d.tagline}</p>}</div>
    <div><p class="lede">{d.shortDescription}</p><div class="actions">{d.externalLinks.length?d.externalLinks.map(link=><StoreCTA link={link} status={d.productStatus}/>):d.links.map(l=><a class="button" href={l.url}>{l.label} ↗</a>)}</div></div>
  </header>
  <figure class="project-hero"><Cover title={d.title!} accent={d.accent} cover={d.cover} category={d.technologies.join(' / ')||d.projectType} eager/>{d.cover&&<figcaption>{d.cover.caption}</figcaption>}</figure>
  <dl class="metadata"><div><dt>My role</dt><dd>{d.roles.join(' · ')}</dd></div>{d.technologies.length>0&&<div><dt>Tools</dt><dd>{d.technologies.join(' · ')}</dd></div>}{d.productStatus&&<div><dt>Status</dt><dd>{statusLabels[d.productStatus]}</dd></div>}{d.context&&<div><dt>Context</dt><dd>{d.context==='internship'?'Professional internship':d.context.replaceAll('-',' ')}</dd></div>}</dl>
  <section id="my-contribution" class="project-ownership"><div><p class="eyebrow">My contribution</p><h2>My part in<br/>the game.</h2></div><div><p class="large-copy">{d.attribution}</p>{d.summary&&<p>{d.summary}</p>}</div></section>
  {d.contributions.length>0&&<section class="contribution-list" aria-label="My responsibilities">{d.contributions.map((c,i)=><article><span class="contribution-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><div><h3>{c.title}</h3><p>{c.description}</p></div></article>)}</section>}
  {related.length>0&&<section id="studies" class="section"><div class="section-heading"><div><p class="eyebrow">Design & implementation</p><h2>Inside this project</h2></div><p>Explore the systems in detail.</p></div><div class="mechanic-grid">{related.map(m=><MechanicCard item={m} parentTitle={d.title}/>)}</div></section>}
  {d.loop&&<section id="gameplay" class="project-loop"><h2>Gameplay</h2><MediaLoop media={d.loop}/></section>}
  <MediaGallery items={d.gallery}/>
  {d.externalLinks.filter(l=>l.kind==='wishlist_steam').map(l=><SteamPanel url={l.url} title={d.title!}/>)}
  <div class="reading"><div class="prose"><Content/></div>{d.breakdowns.length>0&&<section id="design-breakdown" class="article-section"><h2>Design breakdown</h2>{d.breakdowns.map(item=><DecisionSummary item={item}/>)}</section>}{([ ["Challenges",d.challenges],["Production",d.production],["Iteration",d.iterations],["Results",d.outcomes],["Learnings",d.learnings] ] as const).map(([title,items])=>items.length>0&&<section class="article-section"><h2>{title}</h2>{items.map(text=><p>{text}</p>)}</section>)}{d.team&&<section class="article-section"><h2>Project credits</h2><p>{d.team}. This page documents my individual contribution.</p></section>}{d.decisions.length>0&&<section class="article-section"><h2>Key decisions</h2>{d.decisions.map(dec=><article class="decision"><h3>{dec.title}</h3><p>{dec.problem}</p><p>{dec.action}</p>{dec.rationale&&<p>{dec.rationale}</p>}{dec.outcome&&<p>{dec.outcome}</p>}<div>{dec.evidenceIds.map(id=><a class="text-link" href={`#evidence-${id}`}>View evidence →</a>)}</div></article>)}</section>}{d.video&&<VideoPoster video={d.video}/>}<EvidenceList items={d.evidence} compactMedia={d.gallery.length>0}/></div>
  <nav class="detail-end" aria-label="More work"><a href={url('/work/')}>← All projects</a><a href={url(`/work/${next.id}/`)}>Next: {next.data.title} →</a><a href={url('/contact/')}>Get in touch ↗</a></nav>
</div></BaseLayout>
