---
import BaseLayout from '../../layouts/BaseLayout.astro';import ProjectCard from '../../components/ProjectCard.astro';import {content} from '../../lib/content';
const {projects}=await content();const groups=[['game','Games','Independent and academic projects.'],['modding','Modding & community','New experiences within an existing world.'],['collaboration','Collaborations & QA','Contributions to other creators’ games.'],['experiment','Creative coding','Smaller explorations and early experiments.']];
---
<BaseLayout title="Work" description="Explore Nicolás Rodríguez’s games, Kenshi mods, QA collaborations and creative coding experiments, with individual contributions and public references."><div class="shell"><header class="page-heading"><p class="eyebrow">The portfolio / Work</p><h1>Games & other<br/><span class="hero-secondary">playable things.</span></h1><p>Production, design, and development — with a clear account of what I contributed.</p></header><nav class="category-nav" aria-label="Project categories">{groups.map(([key,label])=><a href={`#${key}`}>{label}</a>)}</nav>{groups.map(([key,label,description])=><section id={key} class="section"><div class="section-heading"><div><h2>{label}</h2><p>{description}</p></div><span class="count">{projects.filter(p=>p.data.projectType===key).length} projects</span></div><div class="project-grid">{projects.filter(p=>p.data.projectType===key).map((item,i)=><ProjectCard item={item} index={i+1}/>)}</div></section>)}</div></BaseLayout>
