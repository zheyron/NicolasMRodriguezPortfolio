---
import {render,type CollectionEntry} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import EvidenceList from '../../components/EvidenceList.astro';import VideoPoster from '../../components/VideoPoster.astro';import MechanicCard from '../../components/MechanicCard.astro';import {content} from '../../lib/content';import {withBase} from '../../lib/paths';
export async function getStaticPaths(){const {mechanics}=await content();return mechanics.map(item=>({params:{slug:item.id},props:{item}}));}
interface Props{item:CollectionEntry<'mechanics'>}const {item}=Astro.props;const d=item.data;const {Content}=await render(item);const {projects,mechanics}=await content();const parent=projects.find(p=>p.id===d.parentProject)!;const related=mechanics.filter(m=>m.id!==item.id).slice(0,2);const url=(p:string)=>withBase(p,import.meta.env.BASE_URL);
---
<BaseLayout title={d.title!} description={d.shortDescription}><div class="shell detail"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={url('/mechanics/')}>Mechanics</a><span aria-hidden="true">/</span><span>{d.title}</span></nav><header class="detail-heading"><p class="eyebrow">{d.discipline} / {d.depth==='case-study'?'Case study':'Overview'}</p><h1>{d.title}</h1><p class="lede">{d.shortDescription}</p><a class="text-link" href={url(`/work/${parent.id}/`)}>Part of {parent.data.title} →</a><div class="contribution"><span class="eyebrow">My contribution</span><p>{d.attribution}</p></div></header><div class="reading"><div class="prose"><Content/></div>{d.problem&&<section class="article-section"><h2>Player problem</h2><p>{d.problem}</p></section>}{d.intent&&<section class="article-section"><h2>Design intent</h2><p>{d.intent}</p></section>}{d.constraints.length>0&&<section class="article-section"><h2>Constraints</h2><ul>{d.constraints.map(c=><li>{c}</li>)}</ul></section>}{d.designSummary&&<section class="article-section"><h2>System at a glance</h2><p>{d.designSummary}</p></section>}{d.decisions.length>0&&<section class="article-section"><h2>Design decisions</h2>{d.decisions.map(dec=><article class="decision"><h3>{dec.title}</h3><p>{dec.problem}</p><p>{dec.action}</p>{dec.rationale&&<p>{dec.rationale}</p>}{dec.outcome&&<p>{dec.outcome}</p>}{dec.evidenceIds.map(id=><a class="text-link" href={`#evidence-${id}`}>View evidence →</a>)}</article>)}</section>}{d.iterations.length>0&&<section class="article-section"><h2>Iteration</h2><ol>{d.iterations.map(v=><li>{v}</li>)}</ol></section>}{d.implementationSummary&&<section class="article-section"><h2>My implementation</h2><p>{d.implementationSummary}</p></section>}{d.video&&<VideoPoster video={d.video}/>}<EvidenceList items={d.evidence}/>{d.outcomes.length>0&&<section class="article-section"><h2>Outcome & limitations</h2>{d.outcomes.map(v=><p>{v}</p>)}</section>}{d.learnings.length>0&&<section class="article-section"><h2>Reflection</h2>{d.learnings.map(v=><p>{v}</p>)}</section>}</div>{related.length>0&&<section class="section"><h2>More mechanics</h2><div class="mechanic-grid">{related.map(m=><MechanicCard item={m} parentTitle={projects.find(p=>p.id===m.data.parentProject)?.data.title}/>)}</div></section>}<nav class="detail-end" aria-label="Continue exploring"><a href={url(`/work/${parent.id}/`)}>← Back to {parent.data.title}</a><a href={url('/mechanics/')}>All mechanics</a><a href={url('/contact/')}>Get in touch ↗</a></nav></div></BaseLayout>
