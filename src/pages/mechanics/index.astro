---
import BaseLayout from '../../layouts/BaseLayout.astro';import MechanicCard from '../../components/MechanicCard.astro';import {content} from '../../lib/content';const {projects,mechanics}=await content();
---
<BaseLayout title="Mechanics & Systems" description="A closer look at progression, gameplay and systems in Nicolás Rodríguez’s projects, with source-backed studies and clearly labelled overviews."><div class="shell"><header class="page-heading"><p class="eyebrow">The portfolio / Mechanics</p><h1>Under the<br/><span class="hero-secondary">surface.</span></h1><p>A closer look at how the games work. Case studies connect implementation to evidence; overviews introduce work without claiming a documented development process.</p></header><section class="section"><h2>Mechanics & systems</h2><div class="mechanic-grid">{mechanics.map(item=><MechanicCard item={item} parentTitle={projects.find(p=>p.id===item.data.parentProject)?.data.title}/>)}</div></section></div></BaseLayout>
