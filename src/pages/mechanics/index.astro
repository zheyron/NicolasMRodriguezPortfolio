---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MechanicCard from '../../components/MechanicCard.astro';
import {content} from '../../lib/content';
import {withBase} from '../../lib/paths';
const {projects,mechanics}=await content();
const groups=projects.map(project=>({project,studies:mechanics.filter(item=>item.data.parentProject===project.id)})).filter(group=>group.studies.length);
const url=(path:string)=>withBase(path,import.meta.env.BASE_URL);
---
<BaseLayout title="Mechanics & Systems" description="Explore game design and implementation, organised by project: Jigsaw Jab, Snowballing, and Gingaten.">
  <div class="shell mechanics-index">
    <header class="page-heading">
      <p class="eyebrow">The portfolio / Mechanics</p>
      <h1>Mechanics<br/><span class="hero-secondary">& Systems.</span></h1>
      <p>Explore the decisions and systems behind each game. Choose a project, then dive into a specific mechanic.</p>
      <nav class="mechanics-project-nav" aria-label="Explore mechanics by game">
        {groups.map(({project,studies})=><a href={`#${project.id}`}>{project.data.title}<span>{studies.length} {studies.length===1?'study':'studies'}</span></a>)}
      </nav>
    </header>
    {groups.map(({project,studies})=><section class="mechanics-project section" id={project.id} aria-labelledby={`${project.id}-studies`}>
      <header class="section-heading">
        <div><p class="eyebrow">{project.data.technologies.join(' · ')}</p><h2 id={`${project.id}-studies`}>{project.data.title}</h2></div>
        <a class="text-link" href={url(`/work/${project.id}/`)}>View game project ↗</a>
      </header>
      <div class:list={['mechanic-grid',{'single-study':studies.length===1}]}>
        {studies.map(item=><MechanicCard item={item} parentTitle={project.data.title}/>)}
      </div>
    </section>)}
  </div>
</BaseLayout>
